{
  "schema_version": 5,
  "interaction_language": "zh-CN",
  "artifact_language": "zh-CN",
  "git": {
    "default_branch": "main"
  },
  "execution": {
    "max_implementation_agents": 3,
    "max_integration_attempts": 4,
    "deep_ticket_human_approval": true,
    "shared_path_owner": "explicit"
  },
  "verification": {
    "test": "task test",
    "typecheck": "pnpm --dir go-admin-plus-ui typecheck",
    "lint": "task lint",
    "build": "task build TARGET=all PROFILE=server-sqlite"
  },
  "planning": {
    "default_depth": "standard",
    "require_ready_gate": true,
    "require_evidence": true,
    "ui_prototype_default_variants": 3,
    "ui_prototype_max_variants": 5
  }
}
