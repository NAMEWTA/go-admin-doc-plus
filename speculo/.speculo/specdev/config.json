{
  "artifact_language": "zh-CN",
  "execution": {
    "deep_ticket_human_approval": true,
    "max_implementation_agents": 3,
    "max_integration_attempts": 3,
    "shared_path_owner": "explicit"
  },
  "git": {
    "default_branch": "main"
  },
  "interaction_language": "zh-CN",
  "planning": {
    "default_depth": "standard",
    "require_evidence": true,
    "require_ready_gate": true,
    "ui_prototype_default_variants": 3,
    "ui_prototype_max_variants": 5
  },
  "schema_version": 5,
  "verification": {
    "build": "(cd go-admin-plus && make build) && (cd go-admin-ui-plus && pnpm build:prod)",
    "lint": "cd go-admin-ui-plus && pnpm lint",
    "test": "(cd go-admin-plus && go test ./...) && (cd go-admin-ui-plus && pnpm test:unit)",
    "typecheck": "cd go-admin-ui-plus && pnpm type-check"
  }
}
