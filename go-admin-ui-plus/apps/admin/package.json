{
  "name": "@go-admin/admin",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config ../../vite.config.mjs",
    "build:prod": "vite build --config ../../vite.config.mjs",
    "build:stage": "vite build --mode staging --config ../../vite.config.mjs",
    "preview": "vite preview --config ../../vite.config.mjs",
    "lint": "eslint src ../../tests",
    "type-check": "vue-tsc --noEmit -p ../../tsconfig.json && tsc -p ../../tsconfig.node.json",
    "test:unit": "vitest run --config ../../vitest.config.mjs",
    "test:watch": "vitest --config ../../vitest.config.mjs",
    "e2e": "playwright test --config ../../playwright.config.ts --project=mocked",
    "e2e:live": "playwright test --config ../../playwright.config.ts --project=live",
    "e2e:shots": "playwright test --config ../../playwright.config.ts --project=shots",
    "check:api": "node ../../scripts/check-api-contract.mjs",
    "svgo": "svgo -f src/icons/svg --config=src/icons/svgo.config.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tsparticles/slim": "^3.9.1",
    "@tsparticles/vue3": "^3.0.1",
    "axios": "^1.19.0",
    "codemirror": "^6.0.2",
    "core-js": "^3.50.0",
    "dropzone": "5.9.3",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.4",
    "file-saver": "2.0.5",
    "fuse.js": "6.6.2",
    "js-cookie": "3.0.8",
    "jszip": "3.10.1",
    "moment": "^2.30.1",
    "normalize.css": "8.0.1",
    "nprogress": "0.2.0",
    "path-to-regexp": "6.3.0",
    "pinia": "^4.0.3",
    "remixicon": "^2.5.0",
    "screenfull": "5.2.0",
    "vue": "^3.5.41",
    "vue-codemirror": "^6.1.1",
    "vue-count-to": "1.0.13",
    "vue-cropper": "^1.1.4",
    "vue-router": "^4.6.4",
    "vue3-dnd": "^2.1.0",
    "write-excel-file": "^4.1.1"
  }
}
