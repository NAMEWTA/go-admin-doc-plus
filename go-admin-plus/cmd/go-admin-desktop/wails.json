{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "go-admin-desktop",
  "outputfilename": "go-admin-desktop",
  "frontend:dir": "../../../go-admin-ui-plus",
  "frontend:install": "corepack pnpm install --frozen-lockfile",
  "frontend:build": "corepack pnpm --filter @go-admin/admin build:prod",
  "frontend:dev:watcher": "corepack pnpm --filter @go-admin/admin dev",
  "frontend:dev:serverUrl": "auto",
  "wailsjsdir": "./wailsjs",
  "author": {
    "name": "go-admin-plus"
  }
}
