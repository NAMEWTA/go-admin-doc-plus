{
  "openapi": "3.1.0",
  "info": {
    "title": "Generator API",
    "version": "1.0.0",
    "description": "Authorized current-profile metadata, deterministic preview, and confirmed isolated output.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "/api"
    }
  ],
  "security": [
    {
      "SessionCookie": []
    }
  ],
  "paths": {
    "/generator/configs/{moduleName}": {
      "parameters": [
        {
          "name": "moduleName",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ModuleIdentifier"
          }
        }
      ],
      "get": {
        "operationId": "getGeneratorConfig",
        "summary": "Read the caller-owned persisted normalized generation config",
        "responses": {
          "200": {
            "description": "Persisted config.",
            "headers": {
              "X-CSRF-Token": {
                "$ref": "#/components/headers/CsrfToken"
              },
              "Set-Cookie": {
                "$ref": "#/components/headers/SetCookie"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedGenerationConfig"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationProblem"
          },
          "403": {
            "$ref": "#/components/responses/AuthorizationProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalProblem"
          }
        }
      }
    },
    "/generator/tables": {
      "get": {
        "operationId": "listGeneratorTables",
        "summary": "List allowlisted tables in the current profile schema",
        "responses": {
          "200": {
            "description": "Authorized tables.",
            "headers": {
              "X-CSRF-Token": {
                "$ref": "#/components/headers/CsrfToken"
              },
              "Set-Cookie": {
                "$ref": "#/components/headers/SetCookie"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TableReference"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationProblem"
          },
          "403": {
            "$ref": "#/components/responses/AuthorizationProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalProblem"
          }
        }
      }
    },
    "/generator/tables/{schemaName}/{tableName}": {
      "parameters": [
        {
          "name": "schemaName",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/DatabaseIdentifier"
          }
        },
        {
          "name": "tableName",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/DatabaseIdentifier"
          }
        }
      ],
      "get": {
        "operationId": "getGeneratorTable",
        "summary": "Read normalized metadata for an allowlisted table",
        "responses": {
          "200": {
            "description": "Authorized table metadata.",
            "headers": {
              "X-CSRF-Token": {
                "$ref": "#/components/headers/CsrfToken"
              },
              "Set-Cookie": {
                "$ref": "#/components/headers/SetCookie"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TableMetadata"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationProblem"
          },
          "403": {
            "$ref": "#/components/responses/AuthorizationProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalProblem"
          }
        }
      }
    },
    "/generator/previews": {
      "post": {
        "operationId": "previewGeneratorModule",
        "summary": "Produce a deterministic preview without writing files",
        "security": [
          {
            "SessionCookie": [],
            "CsrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationDraft"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated preview.",
            "headers": {
              "X-CSRF-Token": {
                "$ref": "#/components/headers/CsrfToken"
              },
              "Set-Cookie": {
                "$ref": "#/components/headers/SetCookie"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationPreview"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationProblem"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationProblem"
          },
          "403": {
            "$ref": "#/components/responses/AuthorizationProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalProblem"
          }
        }
      }
    },
    "/generator/writes": {
      "post": {
        "operationId": "writeGeneratorModule",
        "summary": "Consume an actor-bound preview token and atomically publish isolated output",
        "security": [
          {
            "SessionCookie": [],
            "CsrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmedWrite"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Isolated output committed.",
            "headers": {
              "X-CSRF-Token": {
                "$ref": "#/components/headers/CsrfToken"
              },
              "Set-Cookie": {
                "$ref": "#/components/headers/SetCookie"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationProblem"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationProblem"
          },
          "403": {
            "$ref": "#/components/responses/AuthorizationProblem"
          },
          "409": {
            "$ref": "#/components/responses/ConflictProblem"
          },
          "422": {
            "$ref": "#/components/responses/GateProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalProblem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-go-admin-session",
        "description": "Opaque server-side session identifier. JavaScript cannot read the production cookie."
      },
      "CsrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Per-session anti-forgery token required for state-changing Web requests."
      }
    },
    "headers": {
      "CsrfToken": {
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43
        }
      },
      "SetCookie": {
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "schemas": {
      "DatabaseIdentifier": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,62}$"
      },
      "CodeIdentifier": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]{0,63}$"
      },
      "ModuleIdentifier": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]{1,31}$"
      },
      "PathWord": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,63}$"
      },
      "ColumnKind": {
        "type": "string",
        "enum": [
          "string",
          "int64",
          "boolean",
          "decimal",
          "time",
          "uuid",
          "bytes"
        ]
      },
      "TableReference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "name"
        ],
        "properties": {
          "schema": {
            "$ref": "#/components/schemas/DatabaseIdentifier"
          },
          "name": {
            "$ref": "#/components/schemas/DatabaseIdentifier"
          }
        }
      },
      "ColumnMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "databaseType",
          "kind",
          "nullable",
          "primaryKey",
          "ordinal"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/DatabaseIdentifier"
          },
          "databaseType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "$ref": "#/components/schemas/ColumnKind"
          },
          "nullable": {
            "type": "boolean"
          },
          "primaryKey": {
            "type": "boolean"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        }
      },
      "TableMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "table",
          "columns"
        ],
        "properties": {
          "table": {
            "$ref": "#/components/schemas/TableReference"
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/ColumnMetadata"
            }
          }
        }
      },
      "ColumnDraft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "field",
          "include",
          "searchable",
          "sortable"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/DatabaseIdentifier"
          },
          "field": {
            "$ref": "#/components/schemas/CodeIdentifier"
          },
          "include": {
            "type": "boolean"
          },
          "searchable": {
            "type": "boolean"
          },
          "sortable": {
            "type": "boolean"
          }
        }
      },
      "GenerationDraft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "entity",
          "plural",
          "table",
          "columns"
        ],
        "properties": {
          "module": {
            "$ref": "#/components/schemas/ModuleIdentifier"
          },
          "entity": {
            "$ref": "#/components/schemas/CodeIdentifier"
          },
          "plural": {
            "$ref": "#/components/schemas/PathWord"
          },
          "table": {
            "$ref": "#/components/schemas/TableReference"
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/ColumnDraft"
            }
          }
        }
      },
      "PreviewFile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "content": {
            "type": "string",
            "maxLength": 1000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "GenerationPreview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "digest",
          "module",
          "createdAt",
          "expiresAt",
          "files"
        ],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "module": {
            "$ref": "#/components/schemas/ModuleIdentifier"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/PreviewFile"
            }
          }
        }
      },
      "ConfirmedWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "previewToken",
          "confirmed"
        ],
        "properties": {
          "previewToken": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "confirmed": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "SavedGenerationConfig": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "draft",
          "previewDigest"
        ],
        "properties": {
          "draft": {
            "$ref": "#/components/schemas/GenerationDraft"
          },
          "previewDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "WriteResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "directory",
          "files"
        ],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "directory": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]{1,31}-[a-f0-9]{12}$"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "category",
          "code",
          "traceId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "description": "Stable problem type identifier."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "category": {
            "type": "string",
            "enum": [
              "validation",
              "authentication",
              "authorization",
              "not_found",
              "conflict",
              "internal"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "detail": {
            "type": "string",
            "maxLength": 512,
            "description": "Safe client-facing context without infrastructure details."
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "traceId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 64,
            "pattern": "^[a-f0-9]+$"
          },
          "violations": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/ValidationViolation"
            }
          }
        }
      },
      "ValidationViolation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "rule"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "message": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    "responses": {
      "AuthenticationProblem": {
        "description": "Authentication required.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "AuthorizationProblem": {
        "description": "Authorization failed.",
        "headers": {
          "X-CSRF-Token": {
            "$ref": "#/components/headers/CsrfToken"
          },
          "Set-Cookie": {
            "$ref": "#/components/headers/SetCookie"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "ValidationProblem": {
        "description": "Request invalid.",
        "headers": {
          "X-CSRF-Token": {
            "$ref": "#/components/headers/CsrfToken"
          },
          "Set-Cookie": {
            "$ref": "#/components/headers/SetCookie"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFoundProblem": {
        "description": "Metadata or preview not found.",
        "headers": {
          "X-CSRF-Token": {
            "$ref": "#/components/headers/CsrfToken"
          },
          "Set-Cookie": {
            "$ref": "#/components/headers/SetCookie"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "ConflictProblem": {
        "description": "Output already exists.",
        "headers": {
          "X-CSRF-Token": {
            "$ref": "#/components/headers/CsrfToken"
          },
          "Set-Cookie": {
            "$ref": "#/components/headers/SetCookie"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "GateProblem": {
        "description": "Generated output failed a required gate.",
        "headers": {
          "X-CSRF-Token": {
            "$ref": "#/components/headers/CsrfToken"
          },
          "Set-Cookie": {
            "$ref": "#/components/headers/SetCookie"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InternalProblem": {
        "description": "Internal failure.",
        "headers": {
          "X-CSRF-Token": {
            "$ref": "#/components/headers/CsrfToken"
          },
          "Set-Cookie": {
            "$ref": "#/components/headers/SetCookie"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  },
  "x-go-admin-module": "generator",
  "x-go-admin-codegen": {
    "owner": "generator",
    "goPackage": "generatortransport",
    "goOutput": "go-admin-plus/internal/modules/generator/transport/openapi.gen.go",
    "typescriptOutput": "go-admin-plus-ui/packages/domains/generator/src/generated"
  }
}