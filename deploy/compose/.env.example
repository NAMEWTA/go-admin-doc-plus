GO_ADMIN_RELEASE_VERSION=0.0.0-dev
GO_ADMIN_SOURCE_SHA=unknown
# Production Compose requires complete immutable image references. Replace both values with
# image@sha256:<64-hex-digest> before starting a profile.
GO_ADMIN_SERVER_IMAGE=go-admin-plus-server@sha256:REPLACE_WITH_64_HEX_DIGEST
GO_ADMIN_WEB_IMAGE=go-admin-plus-web@sha256:REPLACE_WITH_64_HEX_DIGEST
GO_ADMIN_WEB_BIND=127.0.0.1
GO_ADMIN_WEB_PORT=8080
